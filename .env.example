# Runtime connection (Supabase pooler URL is recommended for the API).
DATABASE_URL="postgresql://postgres:password@localhost:5432/stockline"

# Direct database connection used only by Prisma CLI migrations.
DIRECT_URL="postgresql://postgres:password@localhost:5432/stockline"

ACCESS_TOKEN_SECRET="replace-with-at-least-32-random-characters"
ACCESS_TOKEN_TTL_SECONDS="3600"
REFRESH_TOKEN_TTL_DAYS="14"
PORT="3000"
WEB_ORIGIN="http://localhost:5173"

